#!/bin/sh
# AI学社 pre-commit hook: lint + test before every commit
# Generated by husky v9

npx eslint . --max-warnings=0
LINT_EXIT=$?

if [ $LINT_EXIT -ne 0 ]; then
  echo ""
  echo "[pre-commit] ESLint 检查未通过，请修复错误后再提交。"
  exit $LINT_EXIT
fi

npx vitest run --reporter=verbose
TEST_EXIT=$?

if [ $TEST_EXIT -ne 0 ]; then
  echo ""
  echo "[pre-commit] 单元测试未通过，请修复失败用例后再提交。"
  exit $TEST_EXIT
fi

echo ""
echo "[pre-commit] ✅ Lint & Test 全部通过，允许提交。"
